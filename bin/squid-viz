#!/usr/bin/env node

/**
 * squid-viz — serve the pre-built GSD visualizer with real-time WebSocket streaming.
 *
 * Usage:  squid-viz [--port 5177] [--ws-port 5178] [--gsd-dir /path] [--no-open]
 *
 * --gsd-dir: Explicitly set the .gsd/ directory (auto-discovers from cwd if omitted)
 *
 * - Serves the bundled static UI from dist/
 * - WebSocket server accepts data from GSD extension (push model)
 * - WebSocket server broadcasts to connected browser clients
 * - Auto-opens the browser (skip with --no-open)
 */

import { existsSync, readFileSync } from 'node:fs';
import { join, dirname, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';
import { execSync } from 'node:child_process';
import { createServer } from 'node:http';
import { WebSocketServer, WebSocket } from 'ws';
import { homedir } from 'node:os';

const __dirname = dirname(fileURLToPath(import.meta.url));
const DIST = join(__dirname, '..', 'dist');

// ── Args ─────────────────────────────────────────────────────────────────────

function parseArgs(argv) {
  const args = { port: 5177, wsPort: 5178, gsdDir: null, open: true };
  for (let i = 0; i < argv.length; i++) {
    if (argv[i] === '--no-open') args.open = false;
    else if (argv[i] === '--port' && argv[i + 1]) args.port = parseInt(argv[++i], 10);
    else if (argv[i] === '--ws-port' && argv[i + 1]) args.wsPort = parseInt(argv[++i], 10);
    else if (argv[i] === '--gsd-dir' && argv[i + 1]) args.gsdDir = resolvePath(argv[++i]);
  }
  return args;
}

function resolvePath(p) {
  if (p.startsWith('/')) return p;
  if (p.startsWith('~')) return join(homedir(), p.slice(1));
  return join(process.cwd(), p);
}

const opts = parseArgs(process.argv.slice(2));

// ── Find .gsd/ dir ───────────────────────────────────────────────────────────
// gsdDir always resolves to the .gsd directory itself (never the project root).

function findGsdDir(explicitPath) {
  const p = resolve(explicitPath);
  // User passed the .gsd dir directly
  if (p.endsWith('/.gsd') && existsSync(p)) return p;
  // User passed the project root — look one level down
  const sub = join(p, '.gsd');
  if (existsSync(sub)) return sub;
  return null;
}

function isGlobalGsdDir(p) {
  return existsSync(join(p, 'trusted-projects.json'));
}

let gsdDir;
if (opts.gsdDir) {
  gsdDir = findGsdDir(opts.gsdDir);
  if (!gsdDir) {
    console.error('');
    console.error('Error: no .gsd/ directory found in', resolve(opts.gsdDir));
    console.error('The path must be a GSD project directory that contains a .gsd/ folder.');
    console.error('');
    process.exit(1);
  }
  if (isGlobalGsdDir(gsdDir)) {
    console.error('');
    console.error('Error:', gsdDir, 'is the global GSD installation, not a project.');
    console.error('Run squid-viz from inside a GSD project directory, or use:');
    console.error('  squid-viz --gsd-dir /path/to/your-gsd-project');
    console.error('');
    process.exit(1);
  }
} else {
  const candidate = join(process.cwd(), '.gsd');
  if (existsSync(candidate)) {
    if (isGlobalGsdDir(candidate)) {
      console.error('');
      console.error('Error:', candidate, 'is the global GSD installation, not a project.');
      console.error('Run squid-viz from inside a GSD project directory, or use:');
      console.error('  squid-viz --gsd-dir /path/to/your-gsd-project');
      console.error('');
      process.exit(1);
    }
    gsdDir = candidate;
  } else {
    console.error('');
    console.error('Error: no .gsd/ directory found in', process.cwd());
    console.error('Run squid-viz from inside a GSD project directory, or use:');
    console.error('  squid-viz --gsd-dir /path/to/your-gsd-project');
    console.error('');
    process.exit(1);
  }
}
console.log(`.gsd/ found at: ${gsdDir}`);

// ── Task cache — merged into snapshots so completed tasks stay visible ────────

const TASK_CACHE_FILE = join(gsdDir, 'squid-viz-task-cache.json')

/**
 * Read the task cache from disk on each call (file is small — a few KB at most).
 * Re-reading on every snapshot means we always have the latest without polling.
 * Returns {} if the file doesn't exist or is unreadable.
 */
function readTaskCache() {
  try {
    return JSON.parse(readFileSync(TASK_CACHE_FILE, 'utf-8'))
  } catch {
    return {}
  }
}

/**
 * Merge cached task lists into slices that are done but have an empty tasks array.
 * Operates on an already-parsed snapshot object (mutates in place).
 */
function mergeTaskCache(snapshot) {
  if (!snapshot.milestones) return snapshot
  const cache = readTaskCache()
  if (Object.keys(cache).length === 0) return snapshot
  for (const milestone of snapshot.milestones) {
    if (!milestone.slices) continue
    for (const slice of milestone.slices) {
      if (slice.done && (!slice.tasks || slice.tasks.length === 0)) {
        const cached = cache[`${milestone.id}/${slice.id}`]
        if (cached && cached.length > 0) {
          slice.tasks = cached.map(t => ({ ...t, done: true, active: false }))
        }
      }
    }
  }
  return snapshot
}

// ── HTTP server ──────────────────────────────────────────────────────────────

const MIME = {
  '.html': 'text/html; charset=utf-8',
  '.js': 'application/javascript; charset=utf-8',
  '.css': 'text/css; charset=utf-8',
  '.json': 'application/json; charset=utf-8',
  '.png': 'image/png',
  '.svg': 'image/svg+xml',
};

function serveFile(res, filePath) {
  try {
    const content = readFileSync(filePath);
    const ext = Object.keys(MIME).find(e => filePath.endsWith(e)) || '.bin';
    res.writeHead(200, { 'Content-Type': MIME[ext] });
    res.end(content);
  } catch {
    res.writeHead(404, { 'Content-Type': 'text/plain' });
    res.end('Not found');
  }
}

const server = createServer((req, res) => {
  // ── Serve static files from dist/ ──────────────────────────────────────
  let url = req.url?.split('?')[0] || '/';
  if (url === '/' || url === '/index.html') {
    // Inject the WS port so the browser doesn't hard-code 5178
    try {
      let html = readFileSync(join(DIST, 'index.html'), 'utf-8');
      html = html.replace(
        '<head>',
        `<head><script>window.__SQUID_WS_PORT__=${opts.wsPort};</script>`
      );
      res.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8' });
      res.end(html);
    } catch {
      res.writeHead(404, { 'Content-Type': 'text/plain' });
      res.end('Not found');
    }
  } else {
    serveFile(res, join(DIST, url));
  }
});

// ── WebSocket server (dual purpose) ─────────────────────────────────────────

const wss = new WebSocketServer({ port: opts.wsPort, host: '127.0.0.1' });

// Track connected clients
const extensionClients = new Set();
const browserClients = new Set();
let latestSnapshot = null;
let hasLoggedFirstData = false;
const rejectedProjects = new Set()  // track rejected project paths to suppress repeated logs

// Warn once if no snapshot arrives within 10s of startup
const noDataTimer = setTimeout(() => {
  if (!latestSnapshot) {
    console.warn('[squid-viz] No data received yet — is the GSD extension running for this project?');
    console.warn(`[squid-viz]   Expected project: ${gsdDir.replace(/\/\.gsd$/, '')}`);
  }
}, 10_000);

// ── Heartbeat — detect and cull silently dead connections ───────────────────
// Without this, a TCP connection that dies quietly (router timeout, OS idle
// kill) stays in extensionClients/browserClients with readyState === OPEN
// forever, causing the browser to show stale data with no indication of error.
const HEARTBEAT_INTERVAL = 30_000
setInterval(() => {
  wss.clients.forEach((ws) => {
    if (!ws.isAlive) { ws.terminate(); return; }
    ws.isAlive = false;
    ws.ping();
  });
}, HEARTBEAT_INTERVAL);

// Broadcast to all browser clients
function broadcastToBrowsers(data) {
  browserClients.forEach(client => {
    if (client.readyState === WebSocket.OPEN) {
      client.send(data);
    }
  });
}

// Handle messages from GSD extension
function handleExtensionMessage(data) {
  if (!hasLoggedFirstData) {
    hasLoggedFirstData = true;
    clearTimeout(noDataTimer);
    console.log(`[squid-viz] Receiving data from extension for: ${gsdDir.replace(/\/\.gsd$/, '')}`);
  }
  try {
    const merged = mergeTaskCache(JSON.parse(data))
    const mergedStr = JSON.stringify(merged)
    latestSnapshot = mergedStr
    broadcastToBrowsers(mergedStr)
  } catch {
    // If merge fails for any reason, fall back to raw data
    latestSnapshot = data
    broadcastToBrowsers(data)
  }
}

// Track connected extension (GSD)
wss.on('connection', (ws, req) => {
  // Distinguish clients via query param — both come from 127.0.0.1
  const url = new URL(req.url, 'http://localhost');
  const clientType = url.searchParams.get('client');
  const clientProject = url.searchParams.get('project');
  const isExtension = clientType !== 'browser';
  
  if (isExtension) {
    // Require project identification — reject unidentified extensions
    if (!clientProject) {
      console.log(`[squid-viz] REJECTED extension — no project param`);
      ws.close(1008, 'Missing project param');
      return;
    }
    const normalizedProject = clientProject.endsWith('/.gsd')
      ? clientProject.replace(/\/\.gsd$/, '')
      : clientProject;
    const normalizedGsdDir = gsdDir.replace(/\/\.gsd$/, '');
    if (normalizedProject !== normalizedGsdDir) {
      if (!rejectedProjects.has(normalizedProject)) {
        rejectedProjects.add(normalizedProject)
        console.log(`[squid-viz] REJECTED extension — project ${normalizedProject} != ${normalizedGsdDir}`)
      }
      ws.close(1008, 'Project mismatch');
      return;
    }

    extensionClients.add(ws);
    ws.isAlive = true;
    ws.on('pong', () => { ws.isAlive = true; });

    // If browsers are already waiting with no snapshot yet, ask the extension
    // to push immediately rather than waiting for its 5-second poll.
    if (browserClients.size > 0 && !latestSnapshot) {
      ws.send('browser-connected');
    }

    ws.on('message', (msg) => {
      const data = msg.toString();
      try {
        JSON.parse(data); // validate before broadcasting
        handleExtensionMessage(data);
      } catch (e) {
        console.warn('[squid-viz] invalid message from extension (not valid JSON), dropping');
      }
    });

    ws.on('close', () => {
      extensionClients.delete(ws);
      console.log(`[squid-viz] Extension disconnected — no longer receiving data`);
    });

    ws.on('error', () => {
      // error fires before close — cleanup handled in close handler
    });
  } else {
    // Browser client
    browserClients.add(ws);
    ws.isAlive = true;
    ws.on('pong', () => { ws.isAlive = true; });

    // Send latest snapshot if we have one
    if (latestSnapshot) {
      ws.send(latestSnapshot);
    }

    // Notify extensions that a new browser arrived — they should push
    // a fresh snapshot so the browser doesn't have to wait 5 seconds.
    extensionClients.forEach(ext => {
      if (ext.readyState === WebSocket.OPEN) {
        ext.send('browser-connected');
      }
    });

    ws.on('close', () => {
      browserClients.delete(ws);
    });

    ws.on('error', () => {
      // error fires before close — cleanup handled in close handler
    });
  }
});

wss.on('listening', () => {
  console.log(`WebSocket server running at ws://127.0.0.1:${opts.wsPort}`);
});

wss.on('error', (err) => {
  console.error(`\nError: WebSocket server could not start on port ${opts.wsPort}`);
  console.error(err.code === 'EADDRINUSE'
    ? `  Port ${opts.wsPort} is already in use. Try: squid-viz --ws-port <other-port>`
    : `  ${err.message}`);
  process.exit(1);
});

// ── Start HTTP server ───────────────────────────────────────────────────────

server.on('error', (err) => {
  console.error(`\nError: HTTP server could not start on port ${opts.port}`);
  console.error(err.code === 'EADDRINUSE'
    ? `  Port ${opts.port} is already in use. Try: squid-viz --port <other-port>`
    : `  ${err.message}`);
  process.exit(1);
});

server.listen(opts.port, '127.0.0.1', () => {
  console.log(`squid-viz running at http://127.0.0.1:${opts.port}`);

  // ── Open browser ─────────────────────────────────────────────────────
  if (opts.open) {
    const url = `http://127.0.0.1:${opts.port}`;
    let cmd = '';
    switch (process.platform) {
      case 'darwin': cmd = `open '${url}'`; break;
      case 'win32': cmd = `start '' '${url}'`; break;
      default: cmd = `xdg-open '${url}'`;
    }
    try { execSync(cmd, { stdio: 'ignore' }); } catch { /* ignore */ }
  }
});

// ── Graceful shutdown ───────────────────────────────────────────────────────

process.on('SIGINT', () => {
  console.log('\nShutting down squid-viz...');
  // Force-close all WebSocket connections so wss.close() doesn't hang
  wss.clients.forEach(client => client.terminate());
  wss.close(() => {
    server.close(() => process.exit(0));
  });
  // Safety: exit after 2s even if close callbacks hang
  setTimeout(() => process.exit(1), 2000);
});